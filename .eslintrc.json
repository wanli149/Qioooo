{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "globals": {
    "jQuery": "readonly",
    "$": "readonly",
    "wp": "readonly",
    "api": "readonly",
    "utils": "readonly",
    "qiooooSettings": "readonly",
    "QRCode": "readonly",
    "FastClick": "readonly",
    "Hammer": "readonly",
    "qioooo": "readonly",
    "qioooo_ajax": "readonly"
  },
  "plugins": ["react"],
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:@wordpress/eslint-plugin/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "prefer-const": "error",
    "semi": ["error", "always"]
  }
} 